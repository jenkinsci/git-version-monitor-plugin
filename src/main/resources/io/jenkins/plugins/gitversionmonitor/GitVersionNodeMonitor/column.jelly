<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
    <td align="right" data="${from.toHtml(data)}">
        <j:choose>
            <j:when test="${from.isOutdated(data)}">
                <span class="warning" tooltip="${from.getTooltip(data)}">${from.toHtml(data)}</span>
            </j:when>
            <j:otherwise>
                <span tooltip="${from.getTooltip(data)}">${from.toHtml(data)}</span>
            </j:otherwise>
        </j:choose>
    </td>
</j:jelly>
